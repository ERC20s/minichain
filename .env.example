# Example environment for running the example node
PORT=9300
PEERS=ws://localhost:9301
# Port for the JSON-RPC HTTP API (src/rpc/server.ts). It binds 127.0.0.1 only:
# it answers questions about the tip, balances, nonces, the mempool and the
# staked set, and on that loopback bind it also serves chain_sendTransaction,
# which offers a signed transaction to this node's mempool. No method can submit
# a block. 0 turns the whole API off; unset means 9310.
RPC_PORT=9310
# Opening balances, "hexkey:amount,hexkey:amount" (lower-case hex of the raw
# 32-byte ed25519 public key, non-negative integer amount). This chain has no
# fees, no block reward and no mint transaction, so without this every account
# holds 0, every transfer is refused as unaffordable and nothing is ever minted.
# LOCAL and unverified: every node in one network must be started with the SAME
# value, or the ledgers disagree and the chain forks at the first transfer.
GENESIS_BALANCES=
# Staked validator set, "hexkey:stake,hexkey:stake" (lower-case hex of the raw
# 32-byte ed25519 public key, integer stake). When set, the node accepts a block
# only from the stake-elected proposer. Unset = any validly signed block.
VALIDATORS=
# The ed25519 SEED this node mints blocks with: 64 hex characters (32 bytes).
# Set it and the node runs a proposer loop that drains its mempool into blocks;
# unset (the default) means the node follows and relays and mints nothing. When
# VALIDATORS is set, the matching public key must be in that set and elected for
# the current tip, or nothing is minted. A SECRET — never commit a real value.
PROPOSER_KEY=
# How often the proposer loop tries to mint, in milliseconds. Minimum 100;
# unset means 2000.
PROPOSE_INTERVAL_MS=2000
